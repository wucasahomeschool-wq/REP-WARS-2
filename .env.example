# Local development only. npm run server does NOT read .env automatically;
# supply these variables through your shell or approved environment loader.
NODE_ENV=development
PORT=8787
REP_WARS_ALLOW_DEVELOPMENT_IDENTITY=false
REP_WARS_RUN_LIVE_SUPABASE_TESTS=false
# No credentials means ephemeral in-memory development persistence.
# Both values are required together for Supabase. Never place service keys in Unity.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
